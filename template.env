# Copy to .env and configure your existing S3 bucket before running.
# Compose uses its own isolated development replica set and credentials.
# For a real replica set, include its members and replicaSet name here.
# Omit the database path; choose the authentication DB with authSource.
MONGODB_URI=mongodb://backup:CHANGE_ME@mongo1:27017,mongo2:27017,mongo3:27017/?replicaSet=rs0&authSource=admin
# Use URI_FILE instead of URI for a mounted Docker secret; clear URI above.
MONGODB_URI_FILE=
MONGODB_READ_PREFERENCE=primary
MONGODB_TLS_CA_FILE=
# 1 through 128 simultaneous collections.
MONGODB_PARALLEL_COLLECTIONS=4

# full always includes oplog. Clear all DB selectors in full mode.
# per-database creates separate backups without a point-in-time guarantee.
BACKUP_MODE=full
MONGODB_DATABASE=
MONGODB_DATABASES=
MONGODB_BACKUP_ALL=false
MONGODB_DATABASES_EXCLUDE=

# Optional path INSIDE the container, mounted read-only. Contains mongod.conf,
# keyFile, certificates, Compose definitions, etc. for every source node.
MONGODB_CONFIG_DIR=
# Restore option only: drop collections present in the dump before importing.
MONGODB_RESTORE_DROP=false

S3_REGION=us-west-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SESSION_TOKEN=
S3_BUCKET=
S3_PREFIX=backup
S3_ENDPOINT=
S3_UPLOAD_PART_SIZE_MB=8

# Empty SCHEDULE runs once. Example: CRON_TZ=Asia/Tokyo 0 3 * * *
SCHEDULE=
BACKUP_KEEP_DAYS=
# fixed requires bucket versioning; timestamp uses one new key each time.
BACKUP_FILENAME_MODE=timestamp
# Optional symmetric GPG encryption of the entire bundle, including credentials.
PASSPHRASE=
