# Copy to .env and configure your existing S3 bucket before running.
# Compose uses its own isolated development replica set and credentials.
# For a real replica set, include its members and replicaSet name here.
# Omit the database path; choose the authentication DB with authSource.
# URI serverSelectionTimeoutMS/connectTimeoutMS: positive multiples of 1000 only.
# URI socketTimeoutMS/timeoutMS are unsupported and rejected; omit both.
# Restore/restore-auth reject w=0 and repeated w options; use acknowledged writes.
MONGODB_URI=mongodb://backup:CHANGE_ME@mongo1:27017,mongo2:27017,mongo3:27017/?replicaSet=rs0&authSource=admin
# Use URI_FILE instead of URI for a mounted Docker secret; clear URI above.
MONGODB_URI_FILE=
# Per-database runs warn and use primary for a DB if secondary catch-up cannot be verified.
# Full runs always use primary.
MONGODB_READ_PREFERENCE=primary
MONGODB_TLS_CA_FILE=
# Dump concurrency and requested restore concurrency: 1 through 128.
# Restore may increase this based on archive concurrency; it is not a hard cap.
MONGODB_PARALLEL_COLLECTIONS=4

# full always includes oplog. Clear all DB selectors in full mode.
# If full inventory is unavailable, readable application DBs are saved under partial/.
# To recover one, use BACKUP_MODE=partial and MONGODB_DATABASE=<name>.
# per-database creates separate backups without a point-in-time guarantee.
BACKUP_MODE=full
MONGODB_DATABASE=
# Docker --env-file: use JSON without outer quotes, e.g. ["app","analytics"].
# Empty or [] means no entries; ["private,archive"] selects one literal name.
MONGODB_DATABASES=
MONGODB_BACKUP_ALL=false
# JSON without outer quotes, e.g. ["scratch","temp"] (automatic discovery only).
MONGODB_DATABASES_EXCLUDE=

# Optional path INSIDE the container, mounted read-only. Contains mongod.conf,
# keyFile, certificates, Compose definitions, etc. for every source node.
MONGODB_CONFIG_DIR=
# Restore option only: drop collections present in the dump before importing.
MONGODB_RESTORE_DROP=false

S3_REGION=us-west-1
# Set a complete S3 credential pair, or leave all three fields empty for the AWS chain.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SESSION_TOKEN=
S3_BUCKET=
S3_PREFIX=backup
S3_ENDPOINT=
# Streaming uploads support at most 10,000 parts of the configured size.
# 8 MiB permits 78.125 GiB of compressed/encrypted output; 64 MiB permits 625 GiB.
# Increase this for larger backups; larger parts also increase memory usage.
S3_UPLOAD_PART_SIZE_MB=8

# Empty SCHEDULE runs once. Example: CRON_TZ=Asia/Tokyo 0 3 * * *
SCHEDULE=
# Retention keeps the new backup and newest timestamp generation; clock anomalies stop deletion.
BACKUP_KEEP_DAYS=
# fixed creates independent generation keys unless fixed-key overwrites are explicitly allowed.
BACKUP_FILENAME_MODE=timestamp
# Set true to write a fixed key regardless of bucket versioning.
BACKUP_ALLOW_UNVERSIONED_OVERWRITE=false
# Optional symmetric GPG encryption of the entire bundle, including credentials.
PASSPHRASE=
